{
  "name": "wisdom-mcp",
  "version": "0.1.0",
  "description": "A generic MCP server for books of wisdom. Each book is a content pack; runs on Cloudflare Workers.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "cloudflare-workers",
    "tao-te-ching",
    "leadership",
    "wisdom",
    "claude"
  ],
  "homepage": "https://github.com/mjohnson139/wisdom-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjohnson139/wisdom-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mjohnson139/wisdom-mcp/issues"
  },
  "author": "mjohnson139",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "dev": "npm run bundle && wrangler dev",
    "deploy": "npm run bundle && wrangler deploy",
    "build:local": "npm run bundle && tsc -p tsconfig.local.json",
    "start:local": "node dist/local.js",
    "typecheck": "npm run bundle && tsc",
    "test": "npm run bundle && vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "^0.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
